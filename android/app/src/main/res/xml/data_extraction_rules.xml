<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (targetSdk 36): cloud backup DAN device-to-device transfer.
  Token sesi Supabase, PIN AppLock, dan storage WebView tidak boleh ikut
  berpindah perangkat.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="io.aparajita.capacitor.biometricauth.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="app_webview" />
        <exclude domain="file" path="webview" />
        <exclude domain="file" path="Default" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="io.aparajita.capacitor.biometricauth.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="app_webview" />
        <exclude domain="file" path="webview" />
        <exclude domain="file" path="Default" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
