# Header aset statis (format Cloudflare _headers).
# Ikon brand + manifest selalu no-cache supaya pratinjau/launcher tidak
# tersangkut versi lama saat aset diperbarui. Aset build ber-hash tetap
# di-cache lama oleh konfigurasi hosting default.

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/manifest-chat.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/browserconfig.xml
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/xml; charset=utf-8

/mask-icon.svg
  Cache-Control: no-cache, must-revalidate

/favicon.ico
  Cache-Control: no-cache, must-revalidate

/favicon-*.png
  Cache-Control: no-cache, must-revalidate

/apple-touch-icon.png
  Cache-Control: no-cache, must-revalidate

/icon-*.png
  Cache-Control: no-cache, must-revalidate

/mstile-*.png
  Cache-Control: no-cache, must-revalidate

/og-ace-storage.png
  Cache-Control: no-cache, must-revalidate

/og-image.jpg
  Cache-Control: no-cache, must-revalidate
