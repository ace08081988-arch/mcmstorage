{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["files"],
  "properties": {
    "description": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "pattern": "^src/components/chat/" },
          "reason": { "type": "string", "minLength": 20 }
        },
        "additionalProperties": false
      }
    }
  }
}
