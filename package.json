{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:chat": "cross-env-shell VITE_APP_MODE=chat vite build",
    "cap:sync:full": "bunx cap sync android",
    "cap:sync:chat": "cross-env-shell APP_VARIANT=chat bunx cap sync android",
