    "prebuild:dev": "node scripts/audit-seo-routes.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:mmss": "eslint --max-warnings=0 --no-error-on-unmatched-pattern --rule '{\"no-restricted-syntax\":\"error\"}' \"src/components/chat/**/*.{ts,tsx}\"",
    "lint:mmss:ci": "node scripts/lint-mmss-ci.mjs",
    "format": "prettier --write .",
    "test:visual": "playwright test",
