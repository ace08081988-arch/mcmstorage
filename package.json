    "bench:update-baseline": "UPDATE_BENCH_BASELINE=1 SKIP_BENCH_BASELINE=1 vitest run \"src/routes/_authenticated.gudang.conflict-wide-fields-benchmark.test.ts\"",
    "bench:local": "node scripts/bench-local.mjs",
    "test:package-switch": "vitest run \"src/routes/_authenticated.gudang.package-switch-matrix.test.ts\" \"src/routes/_authenticated.gudang.new-mode-gram-labels.test.ts\" \"src/routes/_authenticated.gudang.package-switch-snapshots.test.ts\" \"src/routes/_authenticated.gudang.qty-price-mutation-snapshots.test.ts\" \"src/lib/beli-derived-gram-switch.test.ts\" \"src/lib/beli-derived-memo-freshness.test.ts\" \"src/lib/wa-url-encode-package-switch.test.ts\" \"src/routes/_authenticated.index.wa-message-package-switch.test.ts\" \"src/lib/wa-bulk-package-switch.test.ts\" \"src/lib/wa-special-chars-package-switch.test.ts\" \"src/routes/_authenticated.gudang.viewport-snapshots.test.ts\"",
    "check:no-turnstile": "node scripts/check-no-turnstile.mjs"
  },
